# PLACEHOLDERS ONLY - this file is safe to upload to GitHub because it contains no real secrets.
#
# On Render you do NOT use a file: type these values into the Render dashboard (Environment tab) or into the
# boxes Render shows when you create the Blueprint. The server itself does not read a ".env" file.
# A real ".env" file is only used by "docker compose" on your own server, and must never be uploaded (.gitignore blocks it).

# ---- Required online ----
NODE_ENV=production
# Render fills this in automatically from the database it creates. Format: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# First administrator. Only used while NO users exist yet. Choose your own values.
ADMIN_USERNAME=choose-your-admin-username
ADMIN_PASSWORD=choose-a-long-password-at-least-10-characters
# Private PIN that unlocks editing of the default Prepared/Approved/Acknowledged names. Do not use "gmpi-admin".
SIGNATORY_PIN=choose-a-private-pin

# ---- Optional ----
# SESSION_HOURS=12            # how long a login lasts
# DATABASE_SSL=true           # only if your database provider demands TLS and the URL does not already say sslmode=require

# ---- Emergency admin recovery (set ONLY when you are locked out, then remove again - see DEPLOY.md) ----
# ADMIN_RESET=true            # together with ADMIN_USERNAME + ADMIN_PASSWORD above: resets that administrator's password

# ---- Only for "docker compose" on your own server ----
# POSTGRES_PASSWORD=choose-a-long-random-database-password
